# Example environment variables for FixYo
# Copy this to .env.local and fill with real values before running locally.

# ─── App ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Optional: restrict CORS to this origin in production
FRONTEND_URL=https://fixyo.ai

# ─── Database (Supabase Postgres) ─────────────────────────────────────────
# Use the session pooler host (aws-0-<region>.pooler.supabase.com:5432), not
# db.<ref>.supabase.co directly -- that host is IPv6-only and many networks
# can't reach it. URL-encode special characters in the password (@ -> %40,
# # -> %23, ! -> %21, etc).
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# ─── Supabase Auth ─────────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/_/settings/api-keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only — never prefix with VITE_, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SendGrid ──────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@fixyo.ai

# ─── AI Generator (OpenAI) ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── File storage (photos/logos/avatars) — Manus Forge storage proxy ──────
# NOTE: this is Manus dev-platform infrastructure, same category of problem
# the OAuth portal was. Uploads will not work in production until this is
# replaced with a real storage provider (e.g. Supabase Storage, S3).
BUILT_IN_FORGE_API_URL=https://forge.manus.computer
BUILT_IN_FORGE_API_KEY=your-forge-api-key

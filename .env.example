# Example environment variables for FixYo
# Copy this to .env and fill with real secrets before running in development or production.

# Server
PORT=3000
NODE_ENV=development

# App / Sessions
SESSION_SECRET=replace_with_a_secure_random_string

# Email (SendGrid or SMTP)
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# AWS (S3) - optional if using S3 for file storage
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional analytics / monitoring
GA_MEASUREMENT_ID=
SENTRY_DSN=

# ─── Supabase Auth ───────────────────────────────────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/_/settings/api-keys
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side only — never prefix with VITE_, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=
# ─── Database (Supabase Postgres — URL-encode special characters in the password) ─
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# ─── Auth / Session ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ─── Manus OAuth ─────────────────────────────────────────────────────────────
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://auth.manus.computer
OWNER_OPEN_ID=your-manus-open-id

# ─── AI / LLM (Manus Forge) ──────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://forge.manus.computer
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── SendGrid ────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
SENDGRID_FROM_EMAIL=noreply@fixyo.ai

# ─── AWS S3 (file / logo uploads) ────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=fixyo-uploads

# ─── App ─────────────────────────────────────────────────────────────────────
# Optional: restrict CORS to this origin in production
FRONTEND_URL=https://fixyo.ai
PORT=3000
